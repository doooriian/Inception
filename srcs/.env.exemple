# Domain used to access the site locally
# Must match nginx server_name and your /etc/hosts entry
DOMAIN_NAME=your_login.42.fr

# MariaDB database configuration
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress_user
MYSQL_PASSWORD=wordpress_password
MYSQL_ROOT_PASSWORD=root_password

# WordPress administrator account
# The username must NOT contain "admin" or "administrator"
WP_ADMIN_USER=main_user
WP_ADMIN_PASSWORD=main_user_password
WP_ADMIN_EMAIL=main_user@example.com

# Additional WordPress user account
WP_USER=regular_user
WP_USER_PASSWORD=regular_user_password
WP_USER_EMAIL=regular_user@example.com
